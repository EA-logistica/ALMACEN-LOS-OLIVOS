# Copiar este archivo como ".env" y completar. ".env" NO se versiona ni se sirve al navegador.

# --- Servidor ---
PORT=4173
# 127.0.0.1 = solo esta PC. Usar 0.0.0.0 para exponerlo en la red interna de la empresa.
HOST=127.0.0.1

# --- Routing (rutas, distancia y tiempo) ---
# osrm = gratuito, sin API key, solo automóvil, sin tráfico.
# ors  = OpenRouteService (plan gratuito con API key), agrega perfil camión (driving-hgv).
ROUTING_PROVIDER=osrm
OSRM_URL=https://router.project-osrm.org
# Si se completa, se habilita el perfil "Camión / vehículo de carga" aunque ROUTING_PROVIDER=osrm.
ORS_API_KEY=
ORS_URL=https://api.openrouteservice.org
ROUTE_CACHE_TTL_DAYS=30

# --- Geocodificación (dirección -> coordenadas) ---
GEOCODING_PROVIDER=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Recomendado por la política de uso de Nominatim: correo de contacto del responsable.
NOMINATIM_EMAIL=

# --- Tráfico ---
# Vacío = usar el factor que ya define la data del Radar (DATA.trafficFactor).
TRAFFIC_FACTOR=
